{
  "name": "chronos-creator",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "description": "Chronos quests on the web: the API the plugin talks to (Cloudflare Worker + D1) and the quest showcase site.",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode offline",
    "dev:otp": "node scripts/dev-otp.mjs",
    "build": "vue-tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc -b",
    "db:migrate:local": "wrangler d1 migrations apply chronos --local",
    "db:migrate:remote": "wrangler d1 migrations apply chronos --remote",
    "db:migrate:development": "wrangler d1 migrations apply chronos-development --remote --env development",
    "deploy": "npm run build && wrangler deploy",
    "deploy:development": "vue-tsc -b && vite build --mode development-deploy && wrangler deploy",
    "cf-typegen": "wrangler types --strict-vars=false"
  },
  "dependencies": {
    "@vue-flow/background": "1.3.2",
    "@vue-flow/controls": "1.1.3",
    "@vue-flow/core": "1.48.2",
    "@vue-flow/minimap": "1.5.4",
    "@vue-flow/node-resizer": "1.5.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.151.1"
  }
}
